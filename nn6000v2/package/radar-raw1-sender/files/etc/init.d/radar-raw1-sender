#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	command -v /usr/bin/radar-raw1-sender >/dev/null 2>&1 || return 0
	# The firmware ships a replaceable placeholder. Do not start it as a
	# procd worker until a real ELF sender has been installed.
	# The placeholder starts with this shebang; a real ELF replacement does not.
	[ "$(sed -n '1p' /usr/bin/radar-raw1-sender 2>/dev/null)" = '#!/bin/sh' ] && return 0
	config_load radar-raw1-sender
	config_get enabled main enabled '1'
	[ "$enabled" = '1' ] || return 0
	config_get iface main interface 'br-lan'
	config_get server main server ''
	config_get client_ip main client_ip ''
	config_get state_listen main state_listen ':9011'
	[ -n "$server" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/radar-raw1-sender \
		--interface "$iface" --server "$server" \
		--state-listen "$state_listen" --start
	[ -n "$client_ip" ] && procd_append_param command --client-ip "$client_ip"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
